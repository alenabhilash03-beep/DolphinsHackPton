# Copy to .env at the repository root. Never commit real credentials.
HYPOTHESIM_ENV=development
HYPOTHESIM_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
API_BASE_URL=http://127.0.0.1:8000
RESEARCH_TIMEOUT_S=180
RESEARCH_MAX_JOBS=4
# Optional persistent job database path; default data/research-jobs.db.
# RESEARCH_DB_PATH=/absolute/path/to/research-jobs.db
# Optional preparation history and validated configuration receipts; default work/preparations.sqlite3.
# PREPARATION_DB_PATH=/absolute/path/to/preparations.sqlite3

# Optional until live AI verification. The simulator will not depend on these.
NVIDIA_API_KEY=
HYPOTHESIM_LLM_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b
LANGSMITH_API_KEY=
LANGSMITH_TRACING=false
LANGSMITH_PROJECT=hypothesim-development
# Set for your account/region when applicable.
# LANGSMITH_WORKSPACE_ID=
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# Hosted accounts (5C.2). Leave AUTH_MODE=off for the local single-user demo.
# AUTH_MODE=supabase
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_ANON_KEY=<public anon key>
# WORKSPACES_DIR=/var/data/workspaces
# AGENT_MAX_CONCURRENT=4
# Web app (apps/web), when accounts are enabled:
# NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=<public anon key>
