{
  "$defs": {
    "Assumption": {
      "additionalProperties": false,
      "properties": {
        "assumption_id": {
          "maxLength": 120,
          "minLength": 1,
          "title": "Assumption Id",
          "type": "string"
        },
        "description": {
          "minLength": 1,
          "title": "Description",
          "type": "string"
        }
      },
      "required": [
        "assumption_id",
        "description"
      ],
      "title": "Assumption",
      "type": "object"
    },
    "BindingParameters": {
      "additionalProperties": false,
      "properties": {
        "affinity_nM": {
          "exclusiveMinimum": 0,
          "title": "Affinity Nm",
          "type": "number"
        },
        "association_nM_inv_h_inv": {
          "exclusiveMinimum": 0,
          "title": "Association Nm Inv H Inv",
          "type": "number"
        },
        "dissociation_h_inv": {
          "exclusiveMinimum": 0,
          "title": "Dissociation H Inv",
          "type": "number"
        }
      },
      "required": [
        "association_nM_inv_h_inv",
        "dissociation_h_inv",
        "affinity_nM"
      ],
      "title": "BindingParameters",
      "type": "object"
    },
    "BolusEvent": {
      "additionalProperties": false,
      "properties": {
        "amount_mg": {
          "minimum": 0,
          "title": "Amount Mg",
          "type": "number"
        },
        "kind": {
          "const": "hypothetical_bolus",
          "title": "Kind",
          "type": "string"
        },
        "start_h": {
          "minimum": 0,
          "title": "Start H",
          "type": "number"
        }
      },
      "required": [
        "kind",
        "start_h",
        "amount_mg"
      ],
      "title": "BolusEvent",
      "type": "object"
    },
    "EvidenceSource": {
      "additionalProperties": false,
      "properties": {
        "identifiers": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Identifiers",
          "type": "object"
        },
        "retrieved_on": {
          "format": "date",
          "title": "Retrieved On",
          "type": "string"
        },
        "source_id": {
          "maxLength": 120,
          "minLength": 1,
          "title": "Source Id",
          "type": "string"
        },
        "source_kind": {
          "enum": [
            "primary_study",
            "product_label",
            "structure_record",
            "database_record"
          ],
          "title": "Source Kind",
          "type": "string"
        },
        "title": {
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "url": {
          "format": "uri",
          "maxLength": 2083,
          "minLength": 1,
          "title": "Url",
          "type": "string"
        },
        "version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Version"
        }
      },
      "required": [
        "source_id",
        "title",
        "url",
        "retrieved_on",
        "source_kind"
      ],
      "title": "EvidenceSource",
      "type": "object"
    },
    "InfusionEvent": {
      "additionalProperties": false,
      "properties": {
        "amount_mg": {
          "minimum": 0,
          "title": "Amount Mg",
          "type": "number"
        },
        "duration_h": {
          "exclusiveMinimum": 0,
          "title": "Duration H",
          "type": "number"
        },
        "kind": {
          "const": "infusion",
          "default": "infusion",
          "title": "Kind",
          "type": "string"
        },
        "start_h": {
          "minimum": 0,
          "title": "Start H",
          "type": "number"
        }
      },
      "required": [
        "start_h",
        "duration_h",
        "amount_mg"
      ],
      "title": "InfusionEvent",
      "type": "object"
    },
    "PKParameters": {
      "additionalProperties": false,
      "properties": {
        "clearance_L_h": {
          "exclusiveMinimum": 0,
          "title": "Clearance L H",
          "type": "number"
        },
        "elimination_half_life_h": {
          "exclusiveMinimum": 0,
          "title": "Elimination Half Life H",
          "type": "number"
        },
        "volume_L": {
          "exclusiveMinimum": 0,
          "title": "Volume L",
          "type": "number"
        }
      },
      "required": [
        "volume_L",
        "clearance_L_h",
        "elimination_half_life_h"
      ],
      "title": "PKParameters",
      "type": "object"
    },
    "ParameterEvidence": {
      "additionalProperties": false,
      "properties": {
        "applicability": {
          "enum": [
            "direct",
            "conditional_transfer",
            "not_applicable"
          ],
          "title": "Applicability",
          "type": "string"
        },
        "context": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Context",
          "type": "object"
        },
        "entered_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Entered At"
        },
        "estimate_type": {
          "enum": [
            "population_model_fit",
            "assay_fit",
            "approximate_property",
            "derivation",
            "design_input",
            "source_reported"
          ],
          "title": "Estimate Type",
          "type": "string"
        },
        "evidence_id": {
          "maxLength": 120,
          "minLength": 1,
          "title": "Evidence Id",
          "type": "string"
        },
        "formula": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Formula"
        },
        "locator": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Locator"
        },
        "normalization": {
          "title": "Normalization",
          "type": "string"
        },
        "original_unit": {
          "minLength": 1,
          "title": "Original Unit",
          "type": "string"
        },
        "original_value": {
          "title": "Original Value",
          "type": "number"
        },
        "parameter": {
          "minLength": 1,
          "title": "Parameter",
          "type": "string"
        },
        "parent_ids": {
          "items": {
            "maxLength": 120,
            "minLength": 1,
            "type": "string"
          },
          "title": "Parent Ids",
          "type": "array"
        },
        "provenance": {
          "enum": [
            "reported",
            "calculated",
            "assumed",
            "user_supplied"
          ],
          "title": "Provenance",
          "type": "string"
        },
        "rationale": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rationale"
        },
        "review_status": {
          "enum": [
            "candidate",
            "reviewed",
            "rejected"
          ],
          "title": "Review Status",
          "type": "string"
        },
        "reviewed_on": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reviewed On"
        },
        "reviewer": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reviewer"
        },
        "source_ids": {
          "items": {
            "maxLength": 120,
            "minLength": 1,
            "type": "string"
          },
          "title": "Source Ids",
          "type": "array"
        },
        "unit": {
          "minLength": 1,
          "title": "Unit",
          "type": "string"
        },
        "value": {
          "title": "Value",
          "type": "number"
        }
      },
      "required": [
        "evidence_id",
        "parameter",
        "value",
        "unit",
        "original_value",
        "original_unit",
        "normalization",
        "provenance",
        "estimate_type",
        "review_status",
        "applicability"
      ],
      "title": "ParameterEvidence",
      "type": "object"
    },
    "ParsedHypothesis": {
      "additionalProperties": false,
      "properties": {
        "ambiguities": {
          "items": {
            "type": "string"
          },
          "title": "Ambiguities",
          "type": "array"
        },
        "drug": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Drug"
        },
        "interventions": {
          "items": {
            "type": "string"
          },
          "title": "Interventions",
          "type": "array"
        },
        "predicted_outcome": {
          "title": "Predicted Outcome",
          "type": "string"
        },
        "target": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Target"
        },
        "unsupported_requests": {
          "items": {
            "type": "string"
          },
          "title": "Unsupported Requests",
          "type": "array"
        }
      },
      "required": [
        "drug",
        "target",
        "interventions",
        "predicted_outcome"
      ],
      "title": "ParsedHypothesis",
      "type": "object"
    },
    "ScenarioConfig": {
      "additionalProperties": false,
      "properties": {
        "administration": {
          "items": {
            "discriminator": {
              "mapping": {
                "hypothetical_bolus": "#/$defs/BolusEvent",
                "infusion": "#/$defs/InfusionEvent"
              },
              "propertyName": "kind"
            },
            "oneOf": [
              {
                "$ref": "#/$defs/InfusionEvent"
              },
              {
                "$ref": "#/$defs/BolusEvent"
              }
            ]
          },
          "maxItems": 100,
          "minItems": 1,
          "title": "Administration",
          "type": "array"
        },
        "assumption_ids": {
          "items": {
            "maxLength": 120,
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "title": "Assumption Ids",
          "type": "array"
        },
        "binding": {
          "$ref": "#/$defs/BindingParameters"
        },
        "body_mass_kg": {
          "exclusiveMinimum": 0,
          "title": "Body Mass Kg",
          "type": "number"
        },
        "dosing_interval_h": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Dosing Interval H"
        },
        "exposure_factor": {
          "minimum": 0,
          "title": "Exposure Factor",
          "type": "number"
        },
        "initial_amount_nmol": {
          "default": 0,
          "minimum": 0,
          "title": "Initial Amount Nmol",
          "type": "number"
        },
        "initial_occupancy": {
          "default": 0,
          "maximum": 1,
          "minimum": 0,
          "title": "Initial Occupancy",
          "type": "number"
        },
        "intervention": {
          "enum": [
            "baseline",
            "half_life_x3",
            "affinity_x10",
            "custom"
          ],
          "title": "Intervention",
          "type": "string"
        },
        "label": {
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "model_id": {
          "const": "one_compartment_effective_binding_v1",
          "default": "one_compartment_effective_binding_v1",
          "title": "Model Id",
          "type": "string"
        },
        "molecular_weight_g_mol": {
          "exclusiveMinimum": 0,
          "title": "Molecular Weight G Mol",
          "type": "number"
        },
        "parameter_evidence": {
          "additionalProperties": {
            "maxLength": 120,
            "minLength": 1,
            "type": "string"
          },
          "title": "Parameter Evidence",
          "type": "object"
        },
        "pk": {
          "$ref": "#/$defs/PKParameters"
        },
        "scenario_id": {
          "maxLength": 120,
          "minLength": 1,
          "title": "Scenario Id",
          "type": "string"
        }
      },
      "required": [
        "scenario_id",
        "label",
        "intervention",
        "pk",
        "binding",
        "molecular_weight_g_mol",
        "body_mass_kg",
        "exposure_factor",
        "administration",
        "assumption_ids",
        "parameter_evidence"
      ],
      "title": "ScenarioConfig",
      "type": "object"
    },
    "SupportAssessment": {
      "additionalProperties": false,
      "properties": {
        "missing_parameters": {
          "items": {
            "type": "string"
          },
          "title": "Missing Parameters",
          "type": "array"
        },
        "reasons": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Reasons",
          "type": "array"
        },
        "status": {
          "enum": [
            "supported",
            "conditional",
            "needs_parameters",
            "unsupported"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "status",
        "reasons"
      ],
      "title": "SupportAssessment",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "assumptions": {
      "items": {
        "$ref": "#/$defs/Assumption"
      },
      "minItems": 1,
      "title": "Assumptions",
      "type": "array"
    },
    "drug": {
      "title": "Drug",
      "type": "string"
    },
    "duration_h": {
      "exclusiveMinimum": 0,
      "title": "Duration H",
      "type": "number"
    },
    "evidence": {
      "items": {
        "$ref": "#/$defs/ParameterEvidence"
      },
      "maxItems": 300,
      "title": "Evidence",
      "type": "array"
    },
    "experiment_id": {
      "maxLength": 120,
      "minLength": 1,
      "title": "Experiment Id",
      "type": "string"
    },
    "hypothesis": {
      "$ref": "#/$defs/ParsedHypothesis"
    },
    "limitations": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Limitations",
      "type": "array"
    },
    "mode": {
      "enum": [
        "reviewed_preset",
        "custom",
        "research_derived"
      ],
      "title": "Mode",
      "type": "string"
    },
    "occupancy_threshold": {
      "default": 0.9,
      "exclusiveMaximum": 1,
      "exclusiveMinimum": 0,
      "title": "Occupancy Threshold",
      "type": "number"
    },
    "scenarios": {
      "items": {
        "$ref": "#/$defs/ScenarioConfig"
      },
      "maxItems": 3,
      "minItems": 1,
      "title": "Scenarios",
      "type": "array"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "sources": {
      "items": {
        "$ref": "#/$defs/EvidenceSource"
      },
      "maxItems": 100,
      "title": "Sources",
      "type": "array"
    },
    "support": {
      "$ref": "#/$defs/SupportAssessment"
    },
    "target": {
      "title": "Target",
      "type": "string"
    },
    "title": {
      "title": "Title",
      "type": "string"
    }
  },
  "required": [
    "experiment_id",
    "title",
    "mode",
    "support",
    "drug",
    "target",
    "hypothesis",
    "duration_h",
    "assumptions",
    "sources",
    "evidence",
    "scenarios",
    "limitations"
  ],
  "title": "ExperimentConfig",
  "type": "object"
}
